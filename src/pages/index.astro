---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recent = posts.slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="My Blog" description="Sujun2238 的个人博客">
  <section class="hero">
    <h1>你好，我是生姜</h1>
    <p class="lead">
      这是我的个人博客，记录学习、思考与生活。基于 <a href="https://astro.build/">Astro</a> 构建，
    </p>
    <a href="/blog" class="cta">阅读全部文章 →</a>
  </section>

  <section class="recent">
    <h2>最新文章</h2>
    {recent.length === 0 ? (
      <p>还没有文章。</p>
    ) : (
      <ul class="post-list">
        {recent.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="post-card">
              <span class="post-title">{post.data.title}</span>
              <time datetime={post.data.pubDate.toISOString()} class="post-date">
                {fmt(post.data.pubDate)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>

<style>
  .hero {
    padding: 1rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }
  .hero h1 {
    margin: 0 0 1rem;
    font-size: 2.25rem;
  }
  .lead {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 42rem;
  }
  .cta {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 600;
  }
  .recent h2 {
    font-size: 1.3rem;
    margin: 0 0 1.25rem;
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 0.75rem;
    transition: border-color 0.15s ease;
  }
  .post-card:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  .post-title {
    font-weight: 600;
    color: var(--fg);
  }
  .post-date {
    color: var(--muted);
    font-size: 0.82rem;
  }
</style>
