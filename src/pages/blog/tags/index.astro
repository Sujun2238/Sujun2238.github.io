---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagMap.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
---

<Layout title="标签统计 - My Blog" description="所有博客标签及其文章数量">
  <section>
    <h1>标签统计</h1>
    <p class="count">共 {tags.length} 个标签，{posts.length} 篇文章</p>

    {tags.length === 0 ? (
      <p>还没有标签。在文章 frontmatter 里加上 <code>tags</code> 字段即可生成标签。</p>
    ) : (
      <ul class="tag-list">
        {tags.map(([tag, count]) => (
          <li>
            <a href={`/blog/tags/${tag}/`} class="tag-item">
              <span class="tag-name">#{tag}</span>
              <span class="tag-count">{count} 篇</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    <p class="back"><a href="/blog">← 返回博客列表</a></p>
  </section>
</Layout>

<style>
  h1 {
    margin: 0 0 0.25rem;
    font-size: 1.75rem;
  }
  .count {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 2rem;
  }
  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-soft);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .tag-item:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .tag-name {
    font-weight: 600;
    color: var(--accent);
    font-size: 0.95rem;
  }
  .tag-count {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .back {
    margin-top: 2.5rem;
  }
</style>
